pipeline {
    agent any

    environment {
        REGISTRY       = 'pratik0207'                  // Docker Hub account / ECR repo
        APP_NAME       = 'microservices-app'
        SONAR_URL      = 'http://13.206.69.137:9000'  // SonarQube EC2 public IP
        SONAR_TOKEN    = credentials('sonar-token')
        ANSIBLE_VAULT  = credentials('ansible-vault')
        PIP_BREAK_SYSTEM_PACKAGES = '1'                // allow pip on Debian 12 (PEP 668)
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.IMAGE_TAG = sh(returnStdout: true, script: 'git rev-parse --short HEAD').trim()
                }
                echo "Building image tag: ${env.IMAGE_TAG}"
            }
        }

        stage('Build & Unit Tests') {
            steps {
                sh 'python3 -m pip install -q -r services/product-service/requirements.txt'
                sh 'python3 -m pip install -q -r services/cart-service/requirements.txt'
                sh 'python3 -m pip install -q -r services/frontend/requirements.txt'
                sh 'python3 -m pip install -q pytest requests'
                sh 'python3 -m pytest services/ --tb=short -q'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh '''
                        sonar-scanner \
                          -Dsonar.projectKey=microservices-app \
                          -Dsonar.sources=services \
                          -Dsonar.host.url=${SONAR_URL} \
                          -Dsonar.login=${SONAR_TOKEN}
                    '''
                }
                // GATE 1: fail pipeline if SonarQube quality gate fails
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'dockerhub-creds') {
                        def frontendImg = docker.build("${env.REGISTRY}/frontend:${env.IMAGE_TAG}", "./services/frontend")
                        def productImg  = docker.build("${env.REGISTRY}/product-service:${env.IMAGE_TAG}", "./services/product-service")
                        def cartImg     = docker.build("${env.REGISTRY}/cart-service:${env.IMAGE_TAG}", "./services/cart-service")

                        // also tag as latest
                        frontendImg.tag("${env.REGISTRY}/frontend:latest")
                        productImg.tag("${env.REGISTRY}/product-service:latest")
                        cartImg.tag("${env.REGISTRY}/cart-service:latest")

                        echo "Images built and tagged: ${env.IMAGE_TAG}"
                    }
                }
            }
        }

        stage('Trivy Vulnerability Scan') {
            steps {
                // GATE 2: fail if CRITICAL or HIGH vulnerabilities found.
                // Trivy runs via Docker, so it does not need to be installed on the Jenkins agent.
                sh '''
                    docker run --rm -v /var/run/docker.sock:/var/run/docker.sock aquasec/trivy:latest image \
                      --exit-code 1 --severity CRITICAL,HIGH --ignore-unfixed \
                      ${REGISTRY}/product-service:${IMAGE_TAG}
                    docker run --rm -v /var/run/docker.sock:/var/run/docker.sock aquasec/trivy:latest image \
                      --exit-code 1 --severity CRITICAL,HIGH --ignore-unfixed \
                      ${REGISTRY}/cart-service:${IMAGE_TAG}
                    docker run --rm -v /var/run/docker.sock:/var/run/docker.sock aquasec/trivy:latest image \
                      --exit-code 1 --severity CRITICAL,HIGH --ignore-unfixed \
                      ${REGISTRY}/frontend:${IMAGE_TAG}
                '''
            }
        }

        stage('Push Images to Registry') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'dockerhub-creds') {
                        docker.image("${env.REGISTRY}/frontend:${env.IMAGE_TAG}").push()
                        docker.image("${env.REGISTRY}/frontend:latest").push()
                        docker.image("${env.REGISTRY}/product-service:${env.IMAGE_TAG}").push()
                        docker.image("${env.REGISTRY}/product-service:latest").push()
                        docker.image("${env.REGISTRY}/cart-service:${env.IMAGE_TAG}").push()
                        docker.image("${env.REGISTRY}/cart-service:latest").push()
                    }
                }
            }
        }

        stage('Deploy to Dev') {
            when { branch 'develop' }
            steps {
                sh 'printf "%s" "$ANSIBLE_VAULT" > /tmp/vault_pass.txt'
                sh '''
                    ansible-playbook -i ansible/inventory/dev/hosts.yml ansible/site.yml \
                      --extra-vars "env=dev image_tag=${IMAGE_TAG} registry=${REGISTRY}" \
                      --vault-password-file /tmp/vault_pass.txt
                '''
            }
        }

        stage('Manual Approval — Production') {
            when { branch 'main' }
            steps {
                input message: 'Approve production deployment?', ok: 'Deploy to Production'
            }
        }

        stage('Deploy to Staging & Production') {
            when { branch 'main' }
            steps {
                sh 'printf "%s" "$ANSIBLE_VAULT" > /tmp/vault_pass.txt'
                sh '''
                    ansible-playbook -i ansible/inventory/staging/hosts.yml ansible/site.yml \
                      --extra-vars "env=staging image_tag=${IMAGE_TAG} registry=${REGISTRY}" \
                      --vault-password-file /tmp/vault_pass.txt
                '''
                sh '''
                    ansible-playbook -i ansible/inventory/prod/hosts.yml ansible/site.yml \
                      --extra-vars "env=prod image_tag=${IMAGE_TAG} registry=${REGISTRY}" \
                      --vault-password-file /tmp/vault_pass.txt
                '''
            }
            post {
                success {
                    script {
                        try {
                            slackSend color: 'good',
                                      message: "*SUCCESS* Microservices app deployed to Staging & Prod (tag: ${env.IMAGE_TAG})"
                        } catch (Exception e) {
                            echo "Slack notification skipped (plugin not configured): ${e.message}"
                        }
                    }
                }
                failure {
                    script {
                        try {
                            slackSend color: 'danger',
                                      message: "*FAILURE* Pipeline failed at tag ${env.IMAGE_TAG}"
                        } catch (Exception e) {
                            echo "Slack notification skipped (plugin not configured): ${e.message}"
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                try {
                    cleanWs()
                } catch (Exception e) {
                    echo "cleanWs skipped (plugin not installed): ${e.message}"
                }
            }
        }
        failure {
            script {
                try {
                    slackSend color: 'danger',
                              message: "*PIPELINE FAILED* ${env.JOB_NAME} #${env.BUILD_NUMBER} — ${env.BUILD_URL}"
                } catch (Exception e) {
                    echo "Slack notification skipped (plugin not configured): ${e.message}"
                }
            }
        }
    }
}
